# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，绝不入库。

# 监听地址。部署到服务器对外提供服务时用 0.0.0.0（由 Caddy 反向代理，不直接暴露）
HOST=127.0.0.1
PORT=8100

# 数据目录（相对路径基于进程工作目录）。存放 SQLite 库与后续的文件存储
DATA_DIR=./data

# 必填。生成命令：openssl rand -hex 32
# 缺失或短于 32 字符时服务端拒绝启动（不提供默认值）
JWT_SECRET=

# 必填。Master Key，用于创建应用与签发 APIKey。至少 16 字符
# 生成命令：openssl rand -hex 24
MASTER_KEY=

# 限流：每个 APIKey（匿名请求按 IP）在窗口内的请求上限
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# 跨域白名单。多个用逗号分隔；* 表示放行全部（仅建议内网/本地使用）
CORS_ORIGIN=*

LOG_LEVEL=info
