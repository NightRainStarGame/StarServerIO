{
  "name": "@ssio/shared",
  "version": "0.1.0",
  "description": "SSIO 跨端共享层：错误码、scope、API 类型、semver 工具",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
