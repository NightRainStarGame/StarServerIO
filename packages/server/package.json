{
  "name": "@ssio/server",
  "version": "0.1.0",
  "description": "SSIO 服务端：Fastify 5 + Drizzle + SQLite，多租户（app）隔离",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    }
  },
  "files": ["dist", "drizzle"],
  "scripts": {
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@sinclair/typebox": "^0.34.40",
    "@ssio/shared": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "jose": "^6.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.0",
    "supertest": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
